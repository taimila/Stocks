using Gtk 4.0;
using Adw 1;

translation-domain "Stocks";

template $GridView : Gtk.Box {
	orientation: vertical;
	hexpand: true;
	vexpand: true;

	Adw.Bin navigationContainer {
		hexpand: true;
		vexpand: true;
	}

	// Navigation pages are detached from this hidden staging container and
	// assigned to ScalingNavView during GridView initialization.
	Box pageStore {
		visible: false;

		Adw.NavigationPage gridContent {
			title: _("Symbols");

			child: Adw.ToolbarView {
				[top]
				Adw.HeaderBar gridHeader {
					show-title: false;
					// Add button is injected here [start]

					[end]
					MenuButton menuButton {
						tooltip-text: _("Main Menu");
						icon-name: "open-menu-symbolic";
						menu-model: primaryMenu;
						primary: true;
					}
				}

				content: ScrolledWindow scrollContainer {
					hscrollbar-policy: never;
				};
			};
		}

		Adw.NavigationPage detailsContent {
			title: _("Details");

			child: Adw.ToolbarView {
				[top]
				Adw.HeaderBar detailsHeader {
					show-title: false;
					show-back-button: false;

					[start]
					// ScalingNavView owns navigation.pop and the custom zoom transition,
					// so HeaderBar's Adw.NavigationView-managed back button cannot be used.
					Button {
						icon-name: "go-previous-symbolic";
						tooltip-text: _("Back");
						action-name: "navigation.pop";

						accessibility {
							label: _("Back");
						}
					}

					[end]
					MenuButton detailsMenuButton {
						tooltip-text: _("Main Menu");
						icon-name: "open-menu-symbolic";
						menu-model: primaryMenu;
						primary: true;
					}
				}

				content: Box {
					orientation: vertical;

					Adw.Banner errorBanner {
						title: _("Refresh failed - Data can be stale");
				  		revealed: false;
					}

					Adw.Bin detailsContainer {
						// Details is injected here.
					}
				};
			};
		}
	}
}

menu primaryMenu {
	section {
		item {
			custom: "themeswitcher";
		}
	}

	section {
		item (_("Keyboard Shortcuts"), "app.shortcuts")
		item (_("About Stocks"), "app.about")
	}

	section {
		item (_("Quit"), "app.quit")
	}
}
